#!/bin/bash
# Creates a release in Octopus Deploy using the `octopus` CLI.
# Credentials come from the environment (OCTOPUS_URL, plus OCTOPUS_ACCESS_TOKEN
# or OCTOPUS_API_KEY); the octopus-login plugin is the recommended way to set them.
set -euo pipefail

if [[ "${BUILDKITE_PLUGIN_CREATE_RELEASE_DEBUG:-false}" =~ (true|on|1) ]] ; then
  echo "--- :octopus-deploy: Enabling debug mode"
  set -x
  env | sort | grep BUILDKITE_PLUGIN_CREATE_RELEASE
fi

fail() {
  echo "🐙 create-release failed: $1" >&2
  exit 1
}

# Reads either a value or a list from plugin config into a global result array
# Returns success if values were read
function plugin_read_list_into_result() {
  local prefix="$1"
  local parameter="${prefix}_0"
  result=()

  if [[ -n "${!parameter:-}" ]]; then
    local i=0
    local parameter="${prefix}_${i}"
    while [[ -n "${!parameter:-}" ]]; do
      result+=("${!parameter}")
      i=$((i+1))
      parameter="${prefix}_${i}"
    done
  elif [[ -n "${!prefix:-}" ]]; then
    result+=("${!prefix}")
  fi

  [[ ${#result[@]} -gt 0 ]] || return 1
}

# Rejected rather than ignored: silently dropping these would change what the build does.
for removed in PACKAGES_FOLDER PACKAGE_PRERELEASE WHAT_IF; do
    var="BUILDKITE_PLUGIN_CREATE_RELEASE_${removed}"
    if [[ -n "${!var:-}" ]]; then
        lower="$(echo "$removed" | tr '[:upper:]' '[:lower:]')"
        fail "'${lower}' is not supported by the octopus CLI. See the README migration notes."
    fi
done

for obsolete in CONFIG_FILE IGNORE_SSL_ERRORS LOG_LEVEL PROXY PROXY_PASSWORD PROXY_USERNAME TIMEOUT; do
    var="BUILDKITE_PLUGIN_CREATE_RELEASE_${obsolete}"
    if [[ -n "${!var:-}" ]]; then
        lower="$(echo "$obsolete" | tr '[:upper:]' '[:lower:]')"
        echo "⚠️  '${lower}' has no octopus CLI equivalent; ignoring." >&2
    fi
done

#server:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_SERVER:-}" ]]; then
    export OCTOPUS_URL="${BUILDKITE_PLUGIN_CREATE_RELEASE_SERVER}"
fi

#api_key: the key itself, not the name of a variable holding it (changed in 0.2.0)
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_API_KEY:-}" ]]; then
    export OCTOPUS_API_KEY="${BUILDKITE_PLUGIN_CREATE_RELEASE_API_KEY}"
fi

[[ -n "${OCTOPUS_URL:-}" ]] || fail "no Octopus URL. Use the octopus-login plugin, or set 'server'."
if [[ -z "${OCTOPUS_ACCESS_TOKEN:-}" && -z "${OCTOPUS_API_KEY:-}" ]]; then
    fail "no credentials. Use the octopus-login plugin, or set 'api_key'."
fi

# --no-prompt so a misconfigured step fails instead of waiting on stdin
cmd=( "release" "create" "--no-prompt" )

#channel:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_CHANNEL:-}" ]]; then
    cmd+=( "--channel" "${BUILDKITE_PLUGIN_CREATE_RELEASE_CHANNEL}" )
fi

#default_package_version:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_DEFAULT_PACKAGE_VERSION:-}" ]]; then
    cmd+=( "--package-version" "${BUILDKITE_PLUGIN_CREATE_RELEASE_DEFAULT_PACKAGE_VERSION}" )
fi

#git_ref:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_GIT_REF:-}" ]]; then
    cmd+=( "--git-ref" "${BUILDKITE_PLUGIN_CREATE_RELEASE_GIT_REF}")
fi

#git_commit:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_GIT_COMMIT:-}" ]]; then
    cmd+=( "--git-commit" "${BUILDKITE_PLUGIN_CREATE_RELEASE_GIT_COMMIT}")
fi

#ignore_channel_rules:
if [[ "${BUILDKITE_PLUGIN_CREATE_RELEASE_IGNORE_CHANNEL_RULES:-false}" =~ ^(true|on|1)$ ]]; then
    cmd+=( "--ignore-channel-rules" )
fi

#ignore_existing:
if [[ "${BUILDKITE_PLUGIN_CREATE_RELEASE_IGNORE_EXISTING:-false}" =~ ^(true|on|1)$ ]]; then
    cmd+=( "--ignore-existing" )
fi

#output_format:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_OUTPUT_FORMAT:-}" ]]; then
    cmd+=( "--output-format" "${BUILDKITE_PLUGIN_CREATE_RELEASE_OUTPUT_FORMAT}" )
fi

#packages:
if plugin_read_list_into_result BUILDKITE_PLUGIN_CREATE_RELEASE_PACKAGES ; then
  for arg in "${result[@]}" ; do
    cmd+=( "--package" "${arg}" )
  done
fi

#project:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_PROJECT:-}" ]]; then
    cmd+=( "--project" "${BUILDKITE_PLUGIN_CREATE_RELEASE_PROJECT}" )
fi

#release_notes:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_RELEASE_NOTES:-}" ]]; then
    cmd+=( "--release-notes" "${BUILDKITE_PLUGIN_CREATE_RELEASE_RELEASE_NOTES}" )
fi

#release_notes_file:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_RELEASE_NOTES_FILE:-}" ]]; then
    cmd+=( "--release-notes-file" "${BUILDKITE_PLUGIN_CREATE_RELEASE_RELEASE_NOTES_FILE}" )
fi

#release_number:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_RELEASE_NUMBER:-}" ]]; then
    cmd+=( "--version" "${BUILDKITE_PLUGIN_CREATE_RELEASE_RELEASE_NUMBER}" )
fi

#space:
if [[ -n "${BUILDKITE_PLUGIN_CREATE_RELEASE_SPACE:-}" ]]; then
    cmd+=( "--space" "${BUILDKITE_PLUGIN_CREATE_RELEASE_SPACE}" )
fi

echo "+++ :octopus-deploy: Running release create"
# shellcheck disable=SC2145
echo "Running command: octopus ${cmd[@]}"

octopus "${cmd[@]}"
